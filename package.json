{
  "name": "nexus-tech-ecommerce",
  "version": "1.0.0",
  "description": "Full-stack modern tech & gadgets e-commerce product",
  "main": "backend/server.js",
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"cyan,magenta\" \"npm run server\" \"npm run client\"",
